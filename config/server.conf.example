# Counter-Inscriptions Counterparty Server Configuration
# Copy this to server.conf and adjust settings

network=counterinscriptions
port=4000
host=0.0.0.0

# Database settings
db_host=localhost
db_port=3306
db_name=counterparty
db_user=root
db_pass=changeme

# Enable all protocol changes (MIME support, etc)
enable_all_protocol_changes=true

# Max message size for file uploads (bytes)
max_message_size=52428800  # 50MB

# API settings
api_enabled=true
cors_enabled=true

# Ordinals settings
ordinals_enabled=true
ordinal_fee_rate_satoshi_per_vbyte=0.5
